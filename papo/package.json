{
  "name": "papo",
  "version": "1.0.0",
  "description": "Papo - chat, calls e compartilhamento de tela",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": { "ws": "^8.18.0" },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.papo.app",
    "productName": "Papo",
    "artifactName": "Papo-${os}.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "setup.html", "config.json", "build/icon.png", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": { "oneClick": true, "perMachine": false },
    "mac": { "target": "dmg", "icon": "build/icon.png", "category": "public.app-category.social-networking" },
    "linux": { "target": "AppImage", "icon": "build/icon.png", "category": "Network" }
  }
}
