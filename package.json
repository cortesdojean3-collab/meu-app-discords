{
  "name": "papo",
  "version": "1.0.0",
  "description": "Papo - chat, calls e compartilhamento de tela",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder --publish never",
    "test": "node --test"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "pg": "^8.13.0",
    "electron-updater": "^6.8.10"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.papo.app",
    "productName": "Papo",
    "artifactName": "Papo-${os}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "screen-share-selection.js",
      "preload.js",
      "picker-preload.js",
      "picker.html",
      "setup.html",
      "config.json",
      "build/icon.png",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "cortesdojean3-collab",
        "repo": "meu-app-discords",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Network"
    }
  },
  "author": "Papo <papo@example.com>",
  "homepage": "https://example.com"
}
